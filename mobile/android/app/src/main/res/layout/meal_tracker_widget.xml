<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/meal_tracker_widget_background"
    android:id="@+id/widget_root">

    <TextView
        android:id="@+id/widget_app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MealTracker"
        android:textSize="11sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/widget_remaining_kcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#4ECCA3" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="kcal remaining"
        android:textSize="12sp"
        android:textColor="#F0F0F0" />

    <TextView
        android:id="@+id/widget_subline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textSize="11sp"
        android:textColor="#888888" />

</LinearLayout>
